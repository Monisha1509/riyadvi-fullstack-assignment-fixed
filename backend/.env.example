PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>
# Local development default. In Render, set CLIENT_ORIGIN to the exact public Vercel domain(s),
# separated by commas if more than one domain must be allowed.
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
ADMIN_TOKEN=replace-with-a-long-random-private-token
